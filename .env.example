# Application
APP_ENV=development
LOG_LEVEL=INFO

# OpenRouter - get your key at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Recommended models (change to any OpenRouter-compatible model)
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Qdrant vector database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=shopping_assistant_documents

# Product provider: 'mock' for demo/tests, 'digikala' for real scraping
PRODUCT_PROVIDER=mock
PRODUCT_SEARCH_TIMEOUT_SECONDS=20

# File uploads
MAX_UPLOAD_SIZE_MB=10

# RAG
RAG_TOP_K=5

# Conversation
CHAT_HISTORY_LIMIT=12

# Locale
DEFAULT_LOCALE=fa-IR
DEFAULT_CURRENCY=IRR
