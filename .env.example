# Application
APP_ENV=development
LOG_LEVEL=INFO

# OpenRouter - get your free key at https://openrouter.ai/
# Sign up -> Settings -> API Keys -> Create Key (free, no credit card needed)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- FREE models (no credits needed, rate-limited) ---
# Chat / intent / response generation
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Vision / image understanding
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# Embeddings: OpenRouter has no free embedding model yet.
# text-embedding-3-small costs ~$0.02 per 1M tokens (tiny for testing).
# To test WITHOUT spending anything: set PRODUCT_PROVIDER=mock and skip /documents/index
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Qdrant vector database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=shopping_assistant_documents

# Product provider: 'mock' for demo/tests (no Playwright, no scraping)
#                   'digikala' for real public-page Playwright scraping
PRODUCT_PROVIDER=mock
PRODUCT_SEARCH_TIMEOUT_SECONDS=20

# File uploads
MAX_UPLOAD_SIZE_MB=10

# RAG
RAG_TOP_K=5

# Conversation
CHAT_HISTORY_LIMIT=12

# Locale
DEFAULT_LOCALE=fa-IR
DEFAULT_CURRENCY=IRR
