# Application
APP_ENV=development
LOG_LEVEL=INFO

# OpenRouter - get your free key at https://openrouter.ai/
# Sign up -> Settings -> API Keys -> Create Key (free, no credit card needed)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Cheap paid models (best value with credits) ---
# Chat / intent / response generation (~$0.10 in / $0.40 out per 1M tokens)
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash-lite

# Vision / image understanding (~$0.10 in / $0.40 out per 1M tokens)
# Same model handles text + images; much cheaper than gpt-4o (~$2.50 in).
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite

# Embeddings for RAG (~$0.02 per 1M tokens; 1536-dim, matches Qdrant collection)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Free alternatives (no credits, rate-limited) ---
# OPENROUTER_CHAT_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# Qdrant vector database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=shopping_assistant_documents

# Product provider: 'mock' for demo/tests (no Playwright, no scraping)
#                   'digikala' for real public-page Playwright scraping
PRODUCT_PROVIDER=mock
PRODUCT_SEARCH_TIMEOUT_SECONDS=20

# File uploads
MAX_UPLOAD_SIZE_MB=10

# RAG
RAG_TOP_K=5

# Conversation
CHAT_HISTORY_LIMIT=12

# ReAct controller: maximum tool-decision rounds per request
REACT_MAX_ITERATIONS=3

# Locale
DEFAULT_LOCALE=fa-IR
DEFAULT_CURRENCY=IRR

# ── LibreChat integration ──────────────────────────────────────────────────
# Used only when running docker-compose.librechat.yml.
# The sale-ai API is reachable from LibreChat as http://sale-ai-api:8000
# No extra vars needed here; see .env.librechat.example for LibreChat vars.
