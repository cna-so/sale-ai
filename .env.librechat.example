# LibreChat environment variables
# Copy to .env.librechat and fill in the blanks
# Docs: https://www.librechat.ai/docs/configuration/dotenv

# ── Required ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_32_char_hex_string
JWT_REFRESH_SECRET=change_me_to_another_random_32_char_hex_string
SESSION_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000

# ── App ───────────────────────────────────────────────────────────────────
APP_TITLE="Digikala AI Assistant"
CUSTOM_FOOTER="Powered by sale-ai & LibreChat"
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# ── Disable providers not in use ──────────────────────────────────────────
# Set to an empty value or 'user_provided' to disable the built-in key prompt
OPENAI_API_KEY=user_provided
ANTHROPIC_API_KEY=user_provided
GOOGLE_KEY=user_provided

# ── Optional: email verification (leave blank to skip) ────────────────────
# EMAIL_SERVICE=gmail
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=
